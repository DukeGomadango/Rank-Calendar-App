# Supabase（必須）
# https://supabase.com/dashboard のプロジェクト設定から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 招待リンク検証用（サーバー側で RLS を超えた読み取りが必要な場合）
# Supabase の Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=

# 本番の OAuth リダイレクト用（任意）
# 例: https://your-app.vercel.app
# NEXT_PUBLIC_APP_URL=

# Sentry（任意・エラー追跡）
# https://sentry.io でプロジェクト作成後、DSN を設定
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# ソースマップアップロード用（CI で設定）
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
